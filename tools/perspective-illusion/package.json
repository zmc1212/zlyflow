{
  "name": "zly-perspective-illusion",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Perspective-illusion renderer: telephoto flat scene opens into 3D (three.js + headless chromium + ffmpeg)",
  "scripts": {
    "serve": "node serve.mjs",
    "stills": "node render_fast.mjs --preview --stills 0.3,1.5,2.5,3.0,4.5,5.6,6.75,7.4,8.6,9.95",
    "preview": "node render_fast.mjs --preview",
    "final": "node render_fast.mjs",
    "check": "python -I scripts/blink_map.py ffmpeg ../../tmp/perspective-illusion/preview.mp4 ../../tmp/perspective-illusion/blink.png"
  },
  "dependencies": {
    "playwright-core": "^1.56.0",
    "three": "0.170.0"
  }
}
