# ComfyUI is not exposed publicly. The host-networked container calls the server-local FRP mapping.
# First start seeds this value into SQLite; after that, super admins can change it in 管理设置 → AI 供应商.
ZLY_AI_VIDEO_STUDIO_COMFY_URL=http://127.0.0.1:18188
# Optional build-time package indexes. Defaults are China mirrors.
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZLY_AI_VIDEO_STUDIO_CREDENTIAL_KEY=

# OAuth MCP: HTTPS origin for public deployments, without a path or trailing slash.
# Local Vite development: http://127.0.0.1:5173. Empty keeps MCP pending configuration.
ZLY_AI_VIDEO_STUDIO_MCP_PUBLIC_BASE_URL=
ZLY_AI_VIDEO_STUDIO_MCP_ENABLED=true

# Optional allow-list for employees using 智能剪辑 → 引用本机 and custom export dirs.
# Admins and super admins may use any readable/writable local path. Export endpoints
# accept an absolute output_dir; without one, films go to data/exports/smart-edit.
# Separate multiple roots with ';' on Windows.
# ZLY_AI_VIDEO_STUDIO_LOCAL_MEDIA_ROOTS=G:\workspace;D:\media
