# ComfyUI is not exposed publicly. The host-networked container calls the server-local FRP mapping.
# First start seeds this value into SQLite; after that, super admins can change it in 管理设置 → AI 供应商.
ZLY_AI_VIDEO_STUDIO_COMFY_URL=http://127.0.0.1:18188
# Optional build-time package indexes. Defaults are China mirrors.
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org
# Docker/server stay on MySQL. sqlite is unittest-only; DATA_DIR is not a backend switch.
# ZLY_AI_VIDEO_STUDIO_DB_BACKEND=mysql
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZLY_AI_VIDEO_STUDIO_CREDENTIAL_KEY=
# Optional: shared Bearer token for the remote Blender action-previs worker.
# Director v5 reliable expansion; set 0 and restart to use v4 for new previews.
ZLY_DIRECTOR_RELIABLE=1
# 按当前 LLM 供应商模型上下文容量调整；输入按字符保守限额，输出为模型 max_tokens。
ZLY_DIRECTOR_INPUT_CHAR_BUDGET=24000
ZLY_DIRECTOR_OUTPUT_TOKEN_BUDGET=16000
# Set the same value on the remote worker before submitting a white-mesh render.
# ZLY_ACTION_PREVIS_WORKER_TOKEN=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICoTSuuw4eOPuecc83okS+G0PPtMKJEip2NLMyzYXsPZ toonflow-remote
