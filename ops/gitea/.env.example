# ZLY 自建 CI 环境配置(setup.sh 首次运行会复制为 .env;.env 已被 .gitignore 忽略)
# 注意:各值不要带空格、引号或 # 等特殊字符

# Gitea 对外地址 = 开发者的 git 远端地址。
# 阶段一(迁移期)GitBlit 还占着 8899,先用 3080;切换时把端口改成 8899(见指南第 3 节),
# 老 git 地址 http://124.70.90.30:8899/r/<仓库>.git 即原样由 Gitea 服务。
GITEA_DOMAIN=124.70.90.30
GITEA_PORT=3080
GITEA_ROOT_URL=http://124.70.90.30:3080/

# Gitea 管理员(setup.sh 自动创建;建议与 GitBlit 管理员同名,如 zlyadmin)
GITEA_ADMIN_USER=zlyadmin
GITEA_ADMIN_PASSWORD=Please-Change-Me-2026
GITEA_ADMIN_EMAIL=admin@zly.local

# 代码组织:必须叫 r —— Gitea 的 clone 地址 /r/<仓库>.git 与 GitBlit 老 URL 同形,
# 这是"老地址不变、无反向代理"的关键
GITEA_ORG=r

# runner 注册 token(setup.sh 自动生成写入,不要手工填写)
GITEA_RUNNER_REGISTRATION_TOKEN=
GITEA_RUNNER_NAME=zly-runner-1

# —— GitBlit → Gitea 一次性迁移(gitblit-migrate.sh 使用;迁完可留档)——
# GitBlit 现地址(迁移期仍由它服务,业务零中断)
GITBLIT_URL=http://124.70.90.30:8899
# GitBlit 的 git 上下文(探测显示你们的实例是 /r/;以实际为准)
GITBLIT_SERVLET=r
# GitBlit 管理员账号(可选:RPC 自动列举仓库、克隆私有仓库时使用)
GITBLIT_ADMIN_USER=
GITBLIT_ADMIN_PASSWORD=
# 仓库清单(空格分隔,不带 .git;留空则先尝试 RPC,RPC 关闭(404)时必须手工填)
GITBLIT_REPOS=
# 从 GitBlit 服务器拷来的用户文件(可选;配置后按同名账号迁移,明文密码原样带走)
GITBLIT_USERS_CONF=
# 迁移到 Gitea 的仓库可见性(false=登录用户可读,贴近 GitBlit 默认行为)
MIGRATE_REPO_PRIVATE=false

TZ=Asia/Shanghai
