# ZLY 自建 CI 环境配置(setup.sh 首次运行会复制为 .env;.env 已被 .gitignore 忽略)
# 注意:各值不要带空格、引号或 # 等特殊字符

# Gitea 对外地址(开发机推代码、部署服务器拉镜像都走这个地址)
GITEA_DOMAIN=124.70.90.30
GITEA_PORT=3080
GITEA_ROOT_URL=http://124.70.90.30:3080/

# Gitea 管理员(setup.sh 自动创建;请务必改掉默认密码)
GITEA_ADMIN_USER=zlyadmin
GITEA_ADMIN_PASSWORD=Please-Change-Me-2026
GITEA_ADMIN_EMAIL=admin@zly.local

# runner 注册 token(setup.sh 自动生成写入,不要手工填写)
GITEA_RUNNER_REGISTRATION_TOKEN=
GITEA_RUNNER_NAME=zly-runner-1

# —— GitBlit → Gitea 同步(老地址无感模式,gitblit-sync.sh 使用)——
# 代码在 Gitea 上的归属组织
GITEA_ORG=zly
# GitBlit 仓库根地址(默认 GitBlit 的 /r 上下文;以实际部署为准)
GITBLIT_BASE=http://124.70.90.30:8899/r
# GitBlit 账号(仓库匿名可读则 GITBLIT_USER 与 GITBLIT_PASSWORD 都留空)
GITBLIT_USER=
GITBLIT_PASSWORD=
# 要同步的 GitBlit 仓库名(空格分隔;Gitea 侧缺仓会自动创建)
SYNC_REPOS=zly-ai-video-studio

TZ=Asia/Shanghai
